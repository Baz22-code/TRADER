//@version=6
indicator("BAZEL POGI", overlay = true, max_labels_count = 500)

// ----------------------------- Inputs ---------------------------------
leftBars  = input.int(5, "Swing Lookback Left",  minval = 1)
rightBars = input.int(5, "Swing Lookback Right", minval = 1)

// ----------------------------- Pivot Detection ---------------------------
pivotHighPrice = ta.pivothigh(leftBars, rightBars)
pivotLowPrice  = ta.pivotlow(leftBars, rightBars)

var float lastConfirmedHigh = na
var float lastConfirmedLow  = na

if not na(pivotHighPrice)
    lastConfirmedHigh := pivotHighPrice

if not na(pivotLowPrice)
    lastConfirmedLow := pivotLowPrice

// ----------------------------- BOS Detection -----------------------------
bool bullishBOS = not na(lastConfirmedHigh) and close > lastConfirmedHigh
bool bearishBOS = not na(lastConfirmedLow)  and close < lastConfirmedLow

// ----------------------------- Plotting ---------------------------------
plotshape(not na(pivotHighPrice), title = "Swing High", style = shape.triangledown, location = location.abovebar, color = color.orange, size = size.tiny, offset = -rightBars)
plotshape(not na(pivotLowPrice),  title = "Swing Low",  style = shape.triangleup,   location = location.belowbar, color = color.blue,   size = size.tiny, offset = -rightBars)

// BOS labels at the swing point that was broken
if bullishBOS
    label.new(bar_index - rightBars, lastConfirmedHigh, "BOS", style = label.style_label_down, color = color.green, textcolor = color.white, size = size.small)

if bearishBOS
    label.new(bar_index - rightBars, lastConfirmedLow, "BOS", style = label.style_label_up, color = color.red, textcolor = color.white, size = size.small)
